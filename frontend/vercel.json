{
  "rewrites": [
    {
      "source": "/edge/api/:path*",
      "destination": "https://rccescanner-production.up.railway.app/api/:path*"
    },
    {
      "source": "/u/beacon",
      "has": [
        { "type": "header", "key": "x-vercel-ip-country", "value": "(?<cc>[A-Z]{2})" },
        { "type": "header", "key": "x-vercel-ip-city", "value": "(?<city>[^/?#&]{1,80})" }
      ],
      "destination": "https://rccescanner-production.up.railway.app/api/usage/beacon?cc=:cc&city=:city"
    },
    {
      "source": "/u/beacon",
      "has": [
        { "type": "header", "key": "x-vercel-ip-country", "value": "(?<cc>[A-Z]{2})" }
      ],
      "destination": "https://rccescanner-production.up.railway.app/api/usage/beacon?cc=:cc"
    },
    {
      "source": "/u/beacon",
      "destination": "https://rccescanner-production.up.railway.app/api/usage/beacon"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/edge/api/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/trader(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/scanner(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
